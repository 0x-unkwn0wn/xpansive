{
  "name": "xpansive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "node scripts/next-with-local-env.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/next-with-local-env.mjs start",
    "db:up": "node scripts/start-local-db.mjs",
    "db:down": "docker compose down",
    "lint": "eslint app components lib next.config.ts drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run test:authorization && npm run test:commercial && npm run test:convergence && npm run test:engine && npm run test:graph-merge && npm run test:persistence && npm run test:email && npm run test:product-events && npm run test:ai && npm run test:ai-providers && npm run test:navigation",
    "test:integration": "npm run test:auth && npm run test:admin && npm run test:admin-invitation && npm run test:account",
    "test:engine": "tsx tests/expansion-engine.test.ts",
    "test:ai": "tsx tests/ai-architecture.test.ts",
    "test:ai-providers": "tsx tests/ai-providers.test.ts",
    "test:navigation": "tsx tests/auth-navigation.test.ts",
    "test:persistence": "tsx tests/persistence.test.ts",
    "test:authorization": "tsx tests/authorization.test.ts",
    "test:auth": "tsx tests/authentication.test.ts",
    "test:admin": "tsx tests/admin-access.test.ts",
    "test:admin-invitation": "tsx tests/admin-invitation.test.ts",
    "test:account": "tsx tests/account-deletion.test.ts",
    "test:commercial": "tsx tests/commercial.test.ts",
    "test:email": "tsx tests/private-beta-email.test.ts",
    "test:product-events": "tsx tests/product-events.test.ts",
    "test:convergence": "tsx tests/convergence.test.ts",
    "test:graph-merge": "tsx tests/graph-merge.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ops:check-env": "node scripts/check-production-env.mjs",
    "admin:bootstrap": "node scripts/bootstrap-first-admin.mjs",
    "email:private-beta": "tsx scripts/generate-private-beta-email.ts",
    "product-events:purge": "node scripts/purge-product-events.mjs",
    "ops:purge": "node scripts/purge-operational-data.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "postgres": "^3.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
