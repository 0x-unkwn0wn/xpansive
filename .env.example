# Required for auth, persistence, Share, Fork, and public explorations.
DATABASE_URL=postgresql://xpansive:xpansive_local@localhost:5432/xpansive
# Public origin for invitation URLs (optional locally).
AUTH_APP_URL=http://localhost:3000
# Local, one-time first-admin bootstrap only; never expose these to the browser.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_CONFIRMATION=
# Server-side transactional email delivery. Currently supported provider: Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
AUTH_EMAIL_FROM=Xpansive <auth@example.com>
AUTH_EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
# Optional comma-separated browser origins when the landing is hosted separately from the API.
WAITLIST_ALLOWED_ORIGINS=
# Optional pseudonymization secret for product-event exploration references.
PRODUCT_EVENTS_SECRET=
# Retention for product events and feedback; purge with npm run product-events:purge.
PRODUCT_EVENTS_RETENTION_DAYS=180
